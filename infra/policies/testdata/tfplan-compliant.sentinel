	# Platform layer: Vault prerequisites, all tagged.
	"module.vault_prerequisites.aws_kms_key.unseal": {
		"address": "module.vault_prerequisites.aws_kms_key.unseal",
		"change": {
			"actions": ["create"],
			"after": {
				"deletion_window_in_days": 7,
				"enable_key_rotation":     true,
				"tags": {
					"Environment": "Dev",
					"ManagedBy":   "Terraform",
					"Project":     "hashi-platform",
				},
				"tags_all": {
					"Environment": "Dev",
					"ManagedBy":   "Terraform",
					"Project":     "hashi-platform",
