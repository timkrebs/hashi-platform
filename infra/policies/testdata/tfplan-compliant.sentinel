				"tags_all": {},
			},
			"before": null,
		},
		"deposed":        "",
		"index":          null,
		"mode":           "managed",
		"module_address": "",
		"name":           "default_tagged",
		"provider_name":  "registry.terraform.io/hashicorp/aws",
		"type":           "aws_cloudwatch_log_group",
	},
	# One mandatory tag has a value known only after apply; the key is still set.
	"aws_security_group.partially_unknown": {
		"address": "aws_security_group.partially_unknown",
		"change": {
			"actions": ["create"],
			"after": {
				"name": "node",
				"tags": {
					"Environment": "Dev",
					"Project":     "hashi-platform",
				},
				"tags_all": {
					"Environment": "Dev",
					"Project":     "hashi-platform",
				},
			},
			"after_unknown": {
				"id": true,
				"tags": {
					"ManagedBy": true,
				},
				"tags_all": {
					"ManagedBy": true,
				},
			},
			"before": null,
		},
		"deposed":        "",
		"index":          null,
		"mode":           "managed",
		"module_address": "",
		"name":           "partially_unknown",
		"provider_name":  "registry.terraform.io/hashicorp/aws",
		"type":           "aws_security_group",
	},
