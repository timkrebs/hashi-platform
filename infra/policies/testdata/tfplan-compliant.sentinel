# A trimmed, sanitised tfplan/v2 mock modelled on the dev environment plan:
# every taggable resource carries the mandatory tags and all compute is
# t3.medium or smaller. Also includes resources the policies must ignore.
terraform_version = "1.15.9"

resource_changes = {
	"module.network.module.vpc.aws_vpc.this[0]": {
		"address": "module.network.module.vpc.aws_vpc.this[0]",
		"change": {
			"actions": ["create"],
			"after": {
				"cidr_block": "10.0.0.0/16",
				"tags": {
					"Environment": "Dev",
					"ManagedBy":   "Terraform",
					"Name":        "hashi-platform-dev-cluster-vpc",
					"Project":     "hashi-platform",
				},
				"tags_all": {
					"Environment": "Dev",
					"ManagedBy":   "Terraform",
					"Name":        "hashi-platform-dev-cluster-vpc",
					"Project":     "hashi-platform",
				},
			},
			"after_unknown": {
				"arn":      true,
				"id":       true,
				"tags":     {},
				"tags_all": {},
			},
			"before": null,
		},
		"deposed":        "",
		"index":          0,
		"mode":           "managed",
		"module_address": "module.network.module.vpc",
		"name":           "this",
		"provider_name":  "registry.terraform.io/hashicorp/aws",
		"type":           "aws_vpc",
	},
	# Tagged only through provider default_tags: `tags` is null, `tags_all` has them.
