# ------------------------------------------------------------------------
# Policy: eks-approved-cluster-version (hard-mandatory)
#
# EKS clusters must run a Kubernetes version from the platform team's
# approved list (current version plus the two previous minor releases).
# Prevents clusters from being created on outdated, unsupported versions.
#
# terraform/10-cluster pins cluster_version = "1.34", which is compliant.
# ------------------------------------------------------------------------

import "tfplan/v2" as tfplan

approved_versions = [
	"1.32",
	"1.33",
	"1.34",
]

eks_clusters = filter tfplan.resource_changes as _, rc {
	rc.type is "aws_eks_cluster" and
		rc.mode is "managed" and
		(rc.change.actions contains "create" or rc.change.actions contains "update")
}

violations = filter eks_clusters as _, rc {
	(rc.change.after.version else "") not in approved_versions
}

print_violations = func(items) {
	for items as address, rc {
		print("POLICY VIOLATION:", address,
			"- cluster version", rc.change.after.version else "(unset)",
			"is not in the approved list:", approved_versions)
	}
	return true
}

reported = print_violations(violations)

main = rule {
	length(violations) is 0
}
