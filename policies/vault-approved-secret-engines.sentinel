# ------------------------------------------------------------------------
# Policy: vault-approved-secret-engines (hard-mandatory)
#
# Only secret engine types vetted by the platform team may be mounted in
# Vault. Prevents teams from enabling unreviewed engines (ssh, database,
# aws, ...) without approval.
#
# terraform/20-vault-config mounts kv-v2 and pki, both approved.
# ------------------------------------------------------------------------

import "tfplan/v2" as tfplan

approved_engines = [
	"kv-v2",
	"pki",
	"transit",
]

vault_mounts = filter tfplan.resource_changes as _, rc {
	rc.type is "vault_mount" and
		rc.mode is "managed" and
		(rc.change.actions contains "create" or rc.change.actions contains "update")
}

violations = filter vault_mounts as _, rc {
	(rc.change.after.type else "") not in approved_engines
}

print_violations = func(items) {
	for items as address, rc {
		print("POLICY VIOLATION:", address,
			"- secret engine type", rc.change.after.type else "(unset)",
			"is not in the approved list:", approved_engines)
	}
	return true
}

reported = print_violations(violations)

main = rule {
	length(violations) is 0
}
