# ------------------------------------------------------------------------
# Policy: restrict-instance-types (soft-mandatory)
#
# EKS managed node groups may only use instance types from the approved
# list below (cost control). Fails when any aws_eks_node_group being
# created or updated requests an instance type outside the list.
#
# terraform/10-cluster uses t3.medium, which is compliant.
# ------------------------------------------------------------------------

import "tfplan/v2" as tfplan

allowed_types = [
	"t3.small",
	"t3.medium",
	"t3.large",
	"m5.large",
]

node_groups = filter tfplan.resource_changes as _, rc {
	rc.type is "aws_eks_node_group" and
		rc.mode is "managed" and
		(rc.change.actions contains "create" or rc.change.actions contains "update")
}

violations = filter node_groups as _, rc {
	any (rc.change.after.instance_types else []) as t {
		t not in allowed_types
	}
}

print_violations = func(items) {
	for items as address, rc {
		print("POLICY VIOLATION:", address,
			"- instance types", rc.change.after.instance_types else [],
			"not all in the approved list", allowed_types)
	}
	return true
}

reported = print_violations(violations)

main = rule {
	length(violations) is 0
}
