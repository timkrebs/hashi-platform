# ------------------------------------------------------------------------
# Policy: require-mandatory-tags (advisory)
#
# Core AWS resources must carry the organization's mandatory tags so cost
# and ownership can be traced. Advisory only: the run proceeds, but the
# missing tags are called out in the run output.
#
# terraform/10-cluster currently sets no tags, so this policy warns on
# every taggable resource in that plan.
# ------------------------------------------------------------------------

import "tfplan/v2" as tfplan

mandatory_tags = [
	"Project",
	"Environment",
	"Owner",
]

taggable_types = [
	"aws_vpc",
	"aws_subnet",
	"aws_eks_cluster",
	"aws_eks_node_group",
	"aws_nat_gateway",
	"aws_security_group",
]

# tags can be absent (undefined) or explicitly null in a plan
get_tags = func(rc) {
	tags = rc.change.after.tags else {}
	if tags is null {
		return {}
	}
	return tags
}

resources = filter tfplan.resource_changes as _, rc {
	rc.type in taggable_types and
		rc.mode is "managed" and
		(rc.change.actions contains "create" or rc.change.actions contains "update")
}

violations = filter resources as _, rc {
	any mandatory_tags as t {
		not (get_tags(rc) contains t)
	}
}

print_violations = func(items) {
	for items as address, rc {
		print("POLICY VIOLATION:", address,
			"- missing one or more mandatory tags:", mandatory_tags)
	}
	return true
}

reported = print_violations(violations)

main = rule {
	length(violations) is 0
}
