# ------------------------------------------------------------------------
# Policy: vault-pki-secure-role (hard-mandatory)
#
# Vault PKI roles must not be allowed to issue certificates for arbitrary
# names. Fails when any vault_pki_secret_backend_role being created or
# updated sets:
#   - allow_any_name     = true   (any CN can be issued)
#   - enforce_hostnames  = false  (non-hostname CNs allowed)
#   - allow_bare_domains = true   (certs for the apex domain itself)
#
# NOTE: terraform/20-vault-config currently violates all three, so this
# policy blocks that run.
# ------------------------------------------------------------------------

import "tfplan/v2" as tfplan

pki_roles = filter tfplan.resource_changes as _, rc {
	rc.type is "vault_pki_secret_backend_role" and
		rc.mode is "managed" and
		(rc.change.actions contains "create" or rc.change.actions contains "update")
}

violations = filter pki_roles as _, rc {
	(rc.change.after.allow_any_name else false) is true or
		(rc.change.after.enforce_hostnames else true) is false or
		(rc.change.after.allow_bare_domains else false) is true
}

print_violations = func(items) {
	for items as address, rc {
		print("POLICY VIOLATION:", address,
			"- PKI role must set allow_any_name = false, enforce_hostnames = true, allow_bare_domains = false")
	}
	return true
}

reported = print_violations(violations)

main = rule {
	length(violations) is 0
}
