# ------------------------------------------------------------------------
# Policy: enforce-tagging-standard (soft-mandatory)
#
# Every core AWS resource must carry the platform's mandatory tags, and
# any Name tag must follow the naming convention:
#
#   {prefix}-{env}-{region}-{component}[-{qualifier}][-{az}]
#    hp     - dev -  euc1  -    eks    -   ng-default
#
# Tokens:
#   prefix  hp                     fixed
#   env     dev | stg | prd        fixed 3 chars
#   region  euc1 | eun1 | use1     eu-central-1, eu-north-1, us-east-1
#   az      1a | 1b | 1c           last chars of the AZ name
#
# terraform/10-cluster applies prefix/env/region via the AWS provider's
# default_tags and names all resources per the convention - compliant.
# ------------------------------------------------------------------------

import "tfplan/v2" as tfplan

name_pattern = "^hp-(dev|stg|prd)-(euc1|eun1|use1)-[a-z0-9]+(-[a-z0-9]+)*$"

mandatory_tags = {
	"prefix": ["hp"],
	"env":    ["dev", "stg", "prd"],
	"region": ["euc1", "eun1", "use1"],
}

taggable_types = [
	"aws_vpc",
	"aws_subnet",
	"aws_internet_gateway",
	"aws_nat_gateway",
	"aws_eks_cluster",
	"aws_eks_node_group",
	"aws_security_group",
]

# tags_all includes the provider's default_tags; fall back to tags
get_tags = func(rc) {
	tags = rc.change.after.tags_all else null
	if tags is null {
		tags = rc.change.after.tags else null
	}
	if tags is null {
		return {}
	}
	return tags
}

is_compliant = func(rc) {
	tags = get_tags(rc)

	if any mandatory_tags as key, allowed {
		not (tags contains key) or tags[key] not in allowed
	} {
		return false
	}

	if tags contains "Name" and not (tags["Name"] matches name_pattern) {
		return false
	}

	return true
}

resources = filter tfplan.resource_changes as _, rc {
	rc.type in taggable_types and
		rc.mode is "managed" and
		(rc.change.actions contains "create" or rc.change.actions contains "update")
}

violations = filter resources as _, rc {
	not is_compliant(rc)
}

print_violations = func(items) {
	for items as address, rc {
		print("POLICY VIOLATION:", address,
			"- must carry tags prefix/env/region with approved values,",
			"and Name must match {prefix}-{env}-{region}-{component}[-{qualifier}][-{az}]")
	}
	return true
}

reported = print_violations(violations)

main = rule {
	length(violations) is 0
}
