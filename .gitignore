# Terraform working files
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variable files may contain secrets. The environment configuration files are
# tracked explicitly; every other *.tfvars stays out of the repository.
*.tfvars
*.tfvars.json
!infra/environments/dev/dev.tfvars
!infra/environments/staging/staging.tfvars
!infra/environments/production/production.tfvars

# Terraform CLI configuration (may contain tokens)
.terraformrc
terraform.rc

# Tool caches and CI scratch output
.tflint.d/
plan.txt
apply.txt
plan-report.md

# Editors and operating systems
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json
